# Maintainer: Navii <https://naviiview.navii.online/>
pkgname=naviiview-bin
pkgver=1.1.2
pkgrel=1
pkgdesc="Comic viewer for your scans: PDF, zip, rar, 7z, epub and image folders, two pages at a time, straight from your NAS or S3"
arch=('x86_64')
url="https://naviiview.navii.online/"
license=('LicenseRef-Freeware')
depends=('webkit2gtk-4.1' 'gtk3')
provides=('naviiview')
conflicts=('naviiview')
options=('!strip')
source=("https://github.com/takakix2/naviiview/releases/download/v${pkgver}/NaviiView_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/takakix2/naviiview/main/LICENSE"
        "online.navii.naviiview.metainfo.xml::https://raw.githubusercontent.com/takakix2/naviiview/main/packaging/linux/online.navii.naviiview.metainfo.xml")
sha256sums=('817a3e8eb4a469704fcf5ecc69c858680f8bb3ad1fc07ddc382a8e4bc3d0047d'
            '12b7ef1808450a160cbeb87699b2f7de93a0cbbe92a59d826a505c1959511796'
            'SKIP')

package() {
  # makepkg already unpacked the .deb (ar); data.tar.gz holds usr/
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/online.navii.naviiview.metainfo.xml" "${pkgdir}/usr/share/metainfo/online.navii.naviiview.metainfo.xml"
}
